lonnes, 7 types d&amp;#x27;anomalies injectées) : 100 % des décalages trouvés, 0 faux positif ; 100 % des lignes décalées retrouvent leurs valeurs d&amp;#x27;origine ; 100 % des dates invalides, valeurs masquées, montants US et parenthèses comptables traités ; résultats identiques à 1 000 000 de lignes. Chiffres et limites : docs/PORTFOLIO.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#566074;" vertex="1" parent="1"><mxGeometry x="30" y="492" width="1440" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 - Streaming et memoire" id="2 -"><mxGraphModel dx="1400" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="620" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 -1" value="&lt;b&gt;Ce qui est lu en flux, et ce qui reste en mémoire&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontSize=20;fontColor=#141c2b;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1340" height="34" as="geometry"/></mxCell><mxCell id="2 -2" value="Lecture : toujours par blocs de 10 000 lignes. Mais certains résultats sont conservés pour la revue humaine (preview, undo) : c&amp;#x27;est le vrai coût mémoire." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontSize=13;fontColor=#566074;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1340" height="24" as="geometry"/></mxCell><mxCell id="2 -3" value="Flux (mémoire constante)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f7f8fa;strokeColor=#c9cfd9;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#566074;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="640" height="40